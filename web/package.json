{
  "name": "nekoport-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts *.ts *.json index.html",
    "format:check": "prettier --check src scripts *.ts *.json index.html",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1zaza/nekoport.git",
    "directory": "web"
  },
  "homepage": "https://github.com/a1zaza/nekoport#readme",
  "bugs": {
    "url": "https://github.com/a1zaza/nekoport/issues"
  }
}
